# Copy file này thành .env rồi điền giá trị thật (không commit .env)
# DB_URL là JDBC URL đầy đủ, build từ HOST/PORT/NAME bên dưới
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurant9
DB_USER=root
DB_PASSWORD=root
DB_URL=jdbc:mysql://localhost:3306/restaurant9?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
